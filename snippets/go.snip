snippet main
alias m
options head
	func main() {
		${0}
	}

snippet print
alias p
	fmt.Print(${0})

snippet printf
alias pf
	fmt.Printf("${1}\n", ${0})

snippet printfdebug
alias pfd
options head
	// begin #########################################
	fmt.Printf("\nDEBUG: ${1}\n\n", ${0})
	// end ###########################################

snippet printfvar
alias pfv
	fmt.Printf("${1}: %#v\n", $1${0})

snippet println
alias pl
	fmt.Println(${0})

snippet sprintf
alias spf
options word
	fmt.Sprintf("${1}", ${0})

snippet sprintfv
alias spfv
options word
	fmt.Sprintf(${0:TARGET})

snippet fprint
alias fp
options word
	fmt.Fprint(${1}, "${0}")

snippet fprintf
alias fpf
options word
	fmt.Fprintf(${1}, "${2}", ${0})

snippet errorf
alias fe
	fmt.Errorf("${1}", ${0})

snippet errorferr
alias fee
	fmt.Errorf("${1}: %w", err)

snippet terrorf
alias tef
	t.Errorf("${1}", ${0})

snippet tfatal
alias tf
	t.Fatal(${0})

snippet tfatalf
alias tff
	t.Fatalf("${1}", ${0})

snippet logprintln
alias lpl
	log.Println("${0}")

snippet logprintf
alias lpf
	log.Printf("${1}", ${0})

snippet logfatal
alias lf
	log.Fatal(${0})

snippet logfatalf
alias lff
	log.Fatalf("${1}", ${0})

snippet iferr
alias e
options head
	if err != nil {
		${0}
	}

snippet iferrreturn
alias er
options head
	if err != nil {
		return ${0}err
	}

snippet iferrreturnfe
alias efe
options head
	if err != nil {
		return fmt.Errorf("${1}: %w", err)
	}

snippet iferrpanic
alias ep
options head
	if err != nil {
		panic(err)
	}${0}

snippet iferrlogfatal
alias elf
options head
	if err != nil {
		log.Fatal(err)
	}${0}

snippet wr
options word
	w http.ResponseWriter, r *http.Request

snippet httperror
alias he
	http.Error(w, "${1}", http.Status${2})
	return
options head

snippet gofunc
alias gf
options head
	go func() {
		${0}
	}()

snippet gofuncarg
alias gfa
options head
	go func(${1:name} ${2:type}) {
		${0}
	}($3)

snippet deferfunc
alias df
options head
	defer func() {
		${0}
	}()

snippet titlecomment
alias tc
options head
	/**************************************************
	* ${0}
	**************************************************/

snippet logtofile
options head
	// begin #########################################
	{
		f, _ := os.OpenFile("/home/i/tmp/go.log", os.O_WRONLY|os.O_CREATE|os.O_APPEND, 0644)
		defer f.Close()
		f.WriteString(${0})
		f.WriteString("\n")
	}
	// end ###########################################

snippet queryfailederror
alias qfe
options word
	fmt.Errorf("query '%s' (params: ${1}) failed: %w", query, ${2}, err)

snippet queryrowcontext
alias qrc
options head
	if err := r.db.QueryRowContext(ctx, query, ${1}).Scan(${0}); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return nil, domainerr.ErrEntityNotFound
		}
		return nil, fmt.Errorf("query '%s' (params: ${2}) failed: %w", query, ${1}, err)
	}

snippet querycontext
alias qc
options head
	rows, err := r.db.QueryContext(ctx, query, ${1})
	if err != nil {
		return nil, fmt.Errorf("query '%s' (params: ${2}) failed: %w", query, ${3}, err)
	}
	defer rows.Close()

	${0}

	for rows.Next() {
		if err := rows.Scan(); err != nil {
			return nil, fmt.Errorf("query '%s' (params: $2) scan failed: %w", query, $3, err)
		}
	}

	if err = rows.Err(); err != nil {
		return nil, fmt.Errorf("query '%s' (params: $2) iteration failed: %w", query, $3, err)
	}
